# Copy to .env and fill in. Never commit .env. Step-by-step instructions for every key: README "Step 6".
# --- Writer (Claude API). Leave empty if you use `ant auth login` instead.
ANTHROPIC_API_KEY=

# --- Publishing targets (each optional; a platform is skipped if its key is empty)
# Dev.to: Settings -> Extensions -> DEV Community API Keys
DEVTO_API_KEY=
# Hashnode: hashnode.com/settings/developer -> Personal Access Token
HASHNODE_TOKEN=
HASHNODE_PUBLICATION_ID=
# LinkedIn: developer app with "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect"
# token scopes: openid profile w_member_social  (tokens last ~60 days)
LINKEDIN_ACCESS_TOKEN=
# Instagram: Graph API (Business/Creator account linked to a Facebook Page)
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
# Cloudinary: hosts Instagram carousel slides (Instagram only accepts public image URLs)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Bluesky: Settings -> Privacy and security -> App passwords (never your main password)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# Threads: Meta developer app -> Threads -> User Token Generator
THREADS_ACCESS_TOKEN=
# Blogger: Google OAuth desktop client + `python cli.py blogger-auth` (fills BLOGGER_REFRESH_TOKEN); blog id goes in config.yaml
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
BLOGGER_REFRESH_TOKEN=

# --- Optional: raises GitHub API rate limit from 60/h to 5000/h
GITHUB_TOKEN=

# --- Optional: full path to Chrome/Chromium/Edge if it is not found automatically (used to render carousels)
CHROME_PATH=
